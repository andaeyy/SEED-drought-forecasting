# backend settings normally supplied by uvicorn
# local secrets only

# gpu and TensorFlow runtime
DROUGHTAPP_GPU_DEVICE=0
CUDA_VISIBLE_DEVICES=0
TF_CPP_MIN_LOG_LEVEL=2
TF_GPU_ALLOCATOR=cuda_malloc_async

# model artifacts and grid metadata
STREAMLIT_MODEL_ARTIFACTS_DIR=../model_artifacts
MODEL_GRID_PATH=../model_artifacts/grid/model_grid.npz

# NLDAS and ELM data locations
NLDAS_BASE_DIR=..
NLDAS_FORCING_DIR=../yearly
ELM_ET_PATH=../ELM_EVAPOTRANSPIRATION_2000_2019.nc
ELM_SM_PATH=../ELM_SM_2000-2019.nc
NLDAS_CACHE_DIR=../droughtapp_cache
NLDAS_SHORTNAME=NLDAS_FORA0125_H

# inference defaults
DEFAULT_HISTORY_DAYS=140
DEFAULT_COPULA_TAU=0.40

# optional noninteractive credentials; prefer persisted login
# python -c "import earthaccess; earthaccess.login(persist=True)"
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# target-specific deployment selected on 2019 validation
SEED_MODEL_VERSION=selected_2019_v20260731
